---
import Window from './Window.astro';
import { bayPlace, hallFrame, hallLayers, roster } from '../data/house';

const creatures = roster();
const layers = hallLayers();
const rose = `${import.meta.env.BASE_URL}frames/hall/rose.svg`;
const roseDay = layers.rose.day ?? rose;
const roseNight = layers.rose.night;
const plates = ['stone', 'floor', 'gilt', 'shafts'] as const;
---

<div class="hall" data-hall>
  <div class="nave">
    <div class="nave-world">
      {
        plates.flatMap((name) => {
          const plate = layers[name];
          return [
            plate.day && (
              <img class="hall-layer hall-layer-day" data-layer-name={name} src={plate.day} alt="" draggable="false" />
            ),
            plate.night && (
              <img class="hall-layer hall-layer-night" data-layer-name={name} src={plate.night} alt="" draggable="false" />
            ),
          ];
        })
      }
      <div class="vault" aria-hidden="true"></div>
      <div class="hall-gilt" aria-hidden="true"></div>
      <div class="hall-shafts" aria-hidden="true"></div>
      <canvas class="hall-dust" data-hall-dust aria-hidden="true"></canvas>
      <div class="apse">
        <div class="rose-mount">
          <img class="rose rose-day" src={roseDay} alt="" />
          {roseNight && <img class="rose rose-night" src={roseNight} alt="" />}
        </div>
        <p class="edition label">Edition II</p>
        <h1>The Bestiary</h1>
        <p class="epithet">
          <span data-layer="almanac">Sixteen windows open on the nave, and in each a world is kept.</span>
          <span data-layer="cipher">Sixteen non-human entities, accessioned, each behind its own arch.</span>
        </p>
        <p class="walk walk-keys">Arrow keys walk the nave. Enter opens a window.</p>
        <p class="walk walk-touch">Scroll the nave. Tap a window.</p>
      </div>
      <div class="floor" aria-hidden="true"></div>
      {
        creatures.map((creature) => {
          const place = bayPlace(creature.depth);
          const frame = hallFrame(creature.frame.glow, creature.frame.particle);
          const style = `--h:${place.height.toFixed(2)};--bottom:${place.bottom.toFixed(2)};--inset:${place.inset.toFixed(2)};--z:${place.z};--fade:${place.fade.toFixed(2)};--name:${place.name}`;
          return (
            <a
              class="bay"
              href={`${import.meta.env.BASE_URL}${creature.slug}/`}
              data-bay
              data-slug={creature.slug}
              data-wall={creature.wall}
              data-depth={creature.depth}
              data-near={place.near ? '' : undefined}
              tabindex={place.tab ? 0 : -1}
              style={style}
            >
              <span class="bay-pool" aria-hidden="true" style={`--glow:${creature.frame.glow}`} />
              <Window
                slug={creature.slug}
                mode="hall"
                frame={frame}
                state={creature.states[0] ?? ''}
                name={creature.entity.name}
              />
              <span class="bay-caption">
                <span class="bay-mark label">{creature.entity.mark}</span>
                <span class="bay-name">{creature.entity.name}</span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</div>
