---
import Window from './Window.astro';
import { HALL, bayMetrics, floorDrop, hallFrame, hallLayers, posterUrl, roster } from '../data/house';

const creatures = roster();
const layers = hallLayers();
const geometry = `--tile:${HALL.tileW}px;--wall-h:${HALL.wallH}px;--tiles:${HALL.tiles};--span:${HALL.span}px;--win-w:${HALL.winW}px;--win-h:${HALL.winH}px;--win-top:${(HALL.winTop * 100).toFixed(1)}%;--drop:${floorDrop()}px;--nave-img:url("${layers.nave.day ?? ''}");--nave-img-night:url("${layers.nave.night ?? layers.nave.day ?? ''}")`;
const tileCount = Array.from({ length: HALL.tiles }, (_, index) => index);
const walls = ['north', 'south'] as const;

function row(layer: { day: string | null; night: string | null } | undefined) {
  return [
    layer?.day ? { phase: 'day' as const, src: layer.day } : null,
    layer?.night ? { phase: 'night' as const, src: layer.night } : null,
  ].filter((item) => item !== null);
}
---

<div class="hall is-painted" data-hall style={geometry}>
  <div class="hall-view">
    <div class="nave-world">
      <div class="nave-dolly">
        <div class="plane floor-plane">
          {
            row(layers.floor).map((plate) => (
              <div class:list={['plate', `plate-${plate.phase}`]} style={`background-image:url("${plate.src}")`} />
            ))
          }
          <span class="floor-sentinel" data-floor-far></span>
          <span class="floor-sentinel" data-floor-near></span>
        </div>
        <div class="plane vault-plane">
          {
            row(layers.vault).map((plate) => (
              <div class:list={['plate', `plate-${plate.phase}`]} style={`background-image:url("${plate.src}")`} />
            ))
          }
          <div class="vault-falloff"></div>
        </div>
        {
          walls.map((wall) => (
            <div class:list={['wall', `wall-${wall}`]} data-wall={wall}>
              <div class="wall-skin">
                {row(layers.wall).map((plate) => (
                  <div class:list={['tile-row', `tile-row-${plate.phase}`]}>
                    {tileCount.map(() => (
                      <img src={plate.src} alt="" draggable="false" />
                    ))}
                  </div>
                ))}
              </div>
              {creatures.map((creature, index) => {
                if (creature.wall !== wall) return null;
                const spot = bayMetrics(creature.depth, creature.wall);
                const frame = hallFrame(creature.frame.glow, creature.frame.particle, creature.frame.opening);
                const near = creature.depth === 0;
                return (
                  <a
                    class="bay"
                    href={`${import.meta.env.BASE_URL}${creature.slug}/`}
                    data-bay
                    data-slug={creature.slug}
                    data-wall={creature.wall}
                    data-depth={creature.depth}
                    data-seq={index}
                    data-near={near ? '' : undefined}
                    tabindex="0"
                    style={`--x:${spot.left.toFixed(1)}px;--along:${spot.along.toFixed(1)};--seq:${index};--name:${near ? 1 : 0};--glow:${creature.frame.glow}`}
                  >
                    <span class="bay-pool" aria-hidden="true" />
                    <Window
                      slug={creature.slug}
                      mode="hall"
                      frame={frame}
                      state={creature.states[0] ?? ''}
                      name={creature.entity.name}
                      priority={near}
                    />
                    <span class="bay-caption">
                      <span class="bay-mark label">{creature.entity.mark}</span>
                      <span class="bay-name">{creature.entity.name}</span>
                    </span>
                  </a>
                );
              })}
            </div>
          ))
        }
        <div class="plane apse-plane">
          {
            row(layers.nave).map((plate) => (
              <img class:list={['nave-img', `plate-${plate.phase}`]} src={plate.src} alt="" draggable="false" />
            ))
          }
          {
            row(layers.rose).map((plate) => (
              <img class:list={['rose-img', `plate-${plate.phase}`]} src={plate.src} alt="" draggable="false" />
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class="floor-glows" aria-hidden="true">
    {creatures.map((creature) => {
      const poster = posterUrl(creature.slug, creature.states[0] ?? '');
      return (
        <span class="floor-glow" data-glow={creature.slug} style={`--glow:${creature.frame.glow}`}>
          {poster ? <i style={`background-image:url("${poster}")`} /> : null}
        </span>
      );
    })}
  </div>
  <div class="hall-copy">
    <p class="edition label">Edition II</p>
    <h1>The Bestiary</h1>
    <p class="epithet">
      <span data-layer="almanac">Sixteen windows open on the nave, and in each a world is kept.</span>
      <span data-layer="cipher">Sixteen non-human entities, accessioned, each behind its own arch.</span>
    </p>
    <p class="walk walk-keys">Arrow keys walk the nave. Enter opens a window.</p>
    <p class="walk walk-touch">Scroll the nave. Tap a window.</p>
  </div>
  <div class="hall-shafts" aria-hidden="true"></div>
  <canvas class="hall-dust" data-hall-dust aria-hidden="true"></canvas>
</div>
