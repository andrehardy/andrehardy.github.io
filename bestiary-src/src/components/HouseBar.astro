---
interface Props {
  current?: 'hall' | 'reports' | 'journal';
}
const { current } = Astro.props;
const hall = `${import.meta.env.BASE_URL}`;
---

<header class="house-bar">
  <a class="house-mark" href={hall}>
    <span class="label">The Magic Registry</span>
    <span class="house-name">The Bestiary</span>
  </a>
  <nav aria-label="The house">
    <ul>
      <li><a class="label" href={hall} aria-current={current === 'hall' ? 'page' : undefined}>The Hall</a></li>
      <li>
        <a class="label" href={`${hall}field-reports/`} aria-current={current === 'reports' ? 'page' : undefined}
          >Field Reports</a
        >
      </li>
      <li>
        <a class="label" href={`${hall}journal/`} aria-current={current === 'journal' ? 'page' : undefined}>The Journal</a>
      </li>
      <li><a class="label" href="/magic-registry/">Back to the Registry</a></li>
    </ul>
  </nav>
  <div class="house-tools">
    <button class="label" type="button" data-cipher-switch aria-pressed="false"><span>Read the Cipher</span></button>
    <button class="label" type="button" data-sound-switch aria-pressed="false">Hear the Specimens</button>
  </div>
</header>
