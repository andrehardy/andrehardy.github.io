---
import Window from '../components/Window.astro';
import { architectureOf } from '../data/architectures';
import { findCreature, openingCaption, orderedSections, roster } from '../data/house';
import House from '../layouts/House.astro';

export function getStaticPaths() {
  return roster().map((creature) => ({
    params: { slug: creature.slug },
    props: { slug: creature.slug },
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const creature = findCreature(slug);
if (!creature) throw new Error(`unknown creature ${slug}`);

const { entity, frame, spec } = creature;
const arch = architectureOf(slug);
const state = creature.states[0] ?? '';
const caption = openingCaption(creature);
const sections = orderedSections(entity.sections);
const vessel = entity.hooks.find((hook) => hook.includes('data-vessel'));
const lichScript = entity.hooks.find((hook) => hook.includes('data-lich-script'));
const ring = `${import.meta.env.BASE_URL}instruments/iron-ring.svg`;
---

<House title={entity.title} description={entity.description} og={entity.og} room={slug}>
  <article
    class="creature leaf"
    data-architecture={arch.id}
    style={`--glow:${frame.glow}`}
  >
    {/* Room ornaments — B11 leaf layers. Painted grounds from MAGIC Builder hook via --wall-ground. */}
    {slug === 'djinn' && <span class="band" data-ornament aria-hidden="true"></span>}
    {slug === 'succubus' && <span class="band" data-ornament aria-hidden="true"></span>}
    {slug === 'vampire' && (
      <>
        <div class="leaf-light warmth" aria-hidden="true"></div>
        <svg
          class="thermopile"
          data-ornament
          aria-hidden="true"
          focusable="false"
          viewBox="-60 -60 120 80"
        >
          <path class="t-scale" d="M-46-6A48 48 0 0 1 46-6"></path>
          <path
            class="t-ticks"
            d="M-44-8l-6-3M-38-24l-5-4M-27-36l-4-5M-14-44l-2-6M0-47v-6M14-44l2-6M27-36l4-5M38-24l5-4M44-8l6-3"
          ></path>
          <path class="t-hot" d="M27-36A48 48 0 0 1 46-6"></path>
          <g class="t-needle">
            <path d="M0 4V-44"></path>
            <circle r="4"></circle>
          </g>
          <path class="t-base" d="M-52 6h104"></path>
        </svg>
      </>
    )}
    {
      slug === 'djinn' && (
        <div class="leaf-light smoke" aria-hidden="true">
          <span class="plume"></span>
          <span class="plume"></span>
          <span class="plume"></span>
        </div>
      )
    }
    {
      slug === 'kitsune' && (
        <>
          <div class="leaf-light snowfall" aria-hidden="true"></div>
          <div class="foxfires" data-ornament aria-hidden="true">
            <span class="foxfire" data-n="1"></span>
            <span class="foxfire" data-n="2"></span>
            <span class="foxfire" data-n="3"></span>
            <span class="foxfire" data-n="4"></span>
            <span class="foxfire" data-n="5"></span>
            <span class="foxfire" data-n="6"></span>
            <span class="foxfire" data-n="7"></span>
            <span class="foxfire" data-n="8"></span>
            <span class="foxfire" data-n="9"></span>
          </div>
        </>
      )
    }
    {
      slug === 'sidhe' && (
        <div class="leaf-light glamour" aria-hidden="true">
          <span class="veil"></span>
          <span class="bare"></span>
          <span class="stone"></span>
          <span class="sheen"></span>
        </div>
      )
    }
    {
      slug === 'will-o-the-wisp' && (
        <>
          <div class="leaf-light lure" aria-hidden="true"></div>
          <div class="far-lights" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
          </div>
        </>
      )
    }
    {
      slug === 'lycanthrope' && (
        <>
          <div class="leaf-light strain" aria-hidden="true"></div>
          <div class="scores" aria-hidden="true"></div>
          <div class="pelt" aria-hidden="true"></div>
          <svg class="cursor-trail" data-cursor="probe" aria-hidden="true" focusable="false">
            <line class="probe-leader" x1="0" y1="0" x2="0" y2="0"></line>
            <circle class="probe-bead" r="3"></circle>
          </svg>
        </>
      )
    }
    {
      slug === 'minotaur' && (
        <svg class="thread" data-ornament aria-hidden="true" focusable="false">
          <path class="clew-line" id="ariadne-thread" pathLength="1"></path>
        </svg>
      )
    }
    {
      slug === 'fae' && (
        <>
          <div class="leaf-light binding" aria-hidden="true"></div>
          <div class="lattice left" data-ornament data-margin aria-hidden="true"></div>
          <div class="lattice right" data-ornament data-margin aria-hidden="true"></div>
        </>
      )
    }
    {
      slug === 'golem' && (
        <div class="sparks" aria-hidden="true"></div>
      )
    }
    {
      slug === 'unicorn' && (
        <div class="leaf-light glare" aria-hidden="true"></div>
      )
    }
    {
      slug === 'lich' && (
        <div class="leaf-light candlelight" aria-hidden="true"></div>
      )
    }
    {
      slug === 'wraith' && (
        <>
          <div class="leaf-light static" aria-hidden="true"></div>
          <div class="wire" data-ornament aria-hidden="true">
            <span class="clean"></span>
            <span class="frayed"></span>
            <span class="head"></span>
          </div>
        </>
      )
    }
    {
      slug === 'succubus' && (
        <>
          <div class="leaf-light closing" aria-hidden="true"></div>
          <div class="leaf-light breathing" aria-hidden="true"></div>
          <div class="breath" data-ornament aria-hidden="true">
            <span class="waves"></span>
            <span class="flat"></span>
          </div>
        </>
      )
    }
    {
      slug === 'ophanim' && (
        <div class="leaf-light gaze" aria-hidden="true"></div>
      )
    }

    <header class="creature-head" data-frame={arch.head}>
      <p class="label mark">{entity.mark}</p>
      <h1>{entity.name}</h1>
      <p class="epithet">
        <span data-layer="almanac">{entity.epithet.almanac}</span>
        <span data-layer="cipher">{entity.epithet.cipher}</span>
      </p>
    </header>

    <div class="room-stack">
      {/* The opening cut into the wall — crypt / vessel / plate / cell centre */}
      <div class="case-bay room" data-frame={arch.case}>
        <div class="window-col">
          <figure
            class="specimen"
            data-specimen={slug}
            data-input={entity.input}
            data-link={entity.link}
            data-voice={entity.voice}
            data-setting={entity.setting}
            data-state={state}
            data-dead-script={slug === 'lich' ? true : undefined}
            tabindex="0"
            aria-label={`${entity.name}. ${spec.hint}`}
          >
            <Window slug={slug} mode="specimen" frame={frame} state={state} name={entity.name}>
              {entity.input === 'iron-lens' && <img slot="world" class="iron-ring" src={ring} alt="" />}
              {slug === 'will-o-the-wisp' && <span slot="world" class="wisp-light" aria-hidden="true"></span>}
              {
                creature.readout && (
                  <p slot="face" class="readout" data-readout aria-hidden="true">
                    0.00
                  </p>
                )
              }
              {vessel && <div slot="face" class="vessel-mount" set:html={vessel} />}
            </Window>
            <div class="sill" aria-hidden="true"></div>
            <figcaption>
              <div class="caption-swap" data-caption-almanac data-layer="almanac">
                <p class="plate is-on">{caption.almanac}</p>
                <p class="plate" aria-hidden="true"></p>
              </div>
              <div class="caption-swap" data-caption-cipher data-layer="cipher">
                <p class="plate is-on">{caption.cipher}</p>
                <p class="plate" aria-hidden="true"></p>
              </div>
              <p class="hint">{spec.hint}</p>
            </figcaption>
            {lichScript && <div class="script-mount" set:html={lichScript} />}
          </figure>
        </div>
      </div>

      {/* Inscriptions recessed in the wall — sections already carry data-frame from B11 */}
      <div class="prose" id="text">
        <div class="accession" set:html={entity.accession} />
        {sections.map((section) => <div class="passage" set:html={section} />)}
      </div>
    </div>

    <footer class="colophon">
      <p class="label">The Bestiary of the Magic Registry · {arch.label}</p>
    </footer>
  </article>
</House>
