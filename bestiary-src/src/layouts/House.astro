---
import '../styles/global.css';
import '../styles/leaf.css';
import '../styles/wall.css';
import '../styles/wall-materials.css';
import '../styles/cursors.css';
import '../styles/rooms/djinn.css';
import '../styles/rooms/fae.css';
import '../styles/rooms/golem.css';
import '../styles/rooms/kitsune.css';
import '../styles/rooms/lich.css';
import '../styles/rooms/lycanthrope.css';
import '../styles/rooms/minotaur.css';
import '../styles/rooms/ophanim.css';
import '../styles/rooms/orc.css';
import '../styles/rooms/sidhe.css';
import '../styles/rooms/succubus.css';
import '../styles/rooms/troll.css';
import '../styles/rooms/unicorn.css';
import '../styles/rooms/vampire.css';
import '../styles/rooms/will-o-the-wisp.css';
import '../styles/rooms/wraith.css';
import HouseBar from '../components/HouseBar.astro';

interface Props {
  title: string;
  description: string;
  og?: Record<string, string>;
  current?: 'hall' | 'reports' | 'journal';
  room?: string;
}

const { title, description, og = {}, current, room } = Astro.props;
const canonical = og['og:url'] ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-edition="bestiary">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/magic-registry/favicon-bestiary.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="view-transition" content="same-origin" />
    {Object.entries(og).map(([property, content]) => <meta property={property} content={content} />)}
    <script is:inline>
      try {
        if (localStorage.getItem('mr-cipher') === '1') document.documentElement.setAttribute('data-cipher', '');
      } catch (error) {
        /* storage refused */
      }
      try {
        var storedNight = localStorage.getItem('mr-bestiary-night');
        if (storedNight === 'on' || storedNight === 'off') {
          document.documentElement.setAttribute('data-night', storedNight);
        } else {
          var hour = new Date().getHours();
          document.documentElement.setAttribute('data-night', hour >= 19 || hour < 6 ? 'on' : 'off');
        }
      } catch (error) {
        /* leave data-night unset so prefers-color-scheme can stand in */
      }
    </script>
  </head>
  <body data-room={room}>
    <a class="skip-link" href="#text">Skip to the text</a>
    <HouseBar current={current} />
    <slot />
    <script>
      import { boot } from '../scripts/boot';
      boot();
    </script>
  </body>
</html>
